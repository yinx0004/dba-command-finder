---
import { t, UI, type Lang } from '../lib/i18n';
import { labSkip, roleNames } from '../lib/roles';
import type { Command, Database } from '../lib/schema';
import type { EntryVerification } from '../lib/verification';

interface Props {
  lang: Lang;
  /** source is drawn blue, target green, whichever databases they are */
  role: 'source' | 'target';
  /** database id, for the version filter */
  db: string;
  dbName: string;
  /** the database's definition, for role tags and why the lab skips a command */
  database?: Database;
  commands: Command[];
  verification?: EntryVerification;
}
const { lang, role, db, dbName, database, commands, verification } = Astro.props;
const ui = UI[lang];

function versionLabel(c: Command): string {
  if (c.since && c.removed_in) return `${c.since} – ${c.removed_in}`;
  if (c.since) return ui.since(c.since);
  if (c.removed_in) return ui.until(c.removed_in);
  return ui.allVersions;
}
---
<div class="card panel">
  <div class="panel-head">
    <span class={`dot dot-${role}`}></span>
    <span class={`side side-${role}`} style="font-size: 13px">{dbName}</span>
  </div>
  {
    commands.map((c) => (
      <div class="cmd" data-ver data-ver-db={db} data-since={c.since} data-removed={c.removed_in}>
        <div class="cmd-line">
          <code>{c.cmd}</code>
          <button type="button" class="copy" data-copy={c.cmd}>
            {ui.copy}
          </button>
        </div>
        <div class="cmd-meta">
          <span class="ver-note badge badge-approx" hidden />
          {(() => {
            const names = roleNames(c, database);
            return names.length ? (
              <span class="roles" title={ui.runsOn}>
                {names.map((n) => (
                  <span class="tag tag-role">{n}</span>
                ))}
              </span>
            ) : null;
          })()}
          <span class="tag">{versionLabel(c)}</span>
          {c.deprecated_in && <span class="badge badge-approx">{ui.deprecatedIn(c.deprecated_in)}</span>}
          {(() => {
            const v = verification?.commands[c.cmd];
            const skip = labSkip(c, database);
            if (skip) return <span class="badge badge-missing">{ui.notRunByLab(t(skip, lang))}</span>;
            if (v?.verified.length)
              return (
                <span class="badge badge-exact">
                  ✓{' '}
                  {v.verified.map((ver, i) => (
                    <>
                      {i > 0 && ' · '}
                      <span data-verified data-db={db} data-v={ver}>
                        {ver}
                      </span>
                    </>
                  ))}
                </span>
              );
            return null;
          })()}
          {c.note && <span>{t(c.note, lang)}</span>}
        </div>
      </div>
    ))
  }
</div>
