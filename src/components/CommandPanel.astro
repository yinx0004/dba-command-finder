---
// One database's commands for a task, each with what the lab saw on every version it ran.
import type { Verification } from '../../lab/plan';
import { t, UI, type Lang } from '../lib/i18n';
import { commandRuns } from '../lib/proof';
import { labSkip, roleNames } from '../lib/roles';
import type { Command, Database, DatabaseEntry } from '../lib/schema';

interface Props {
  lang: Lang;
  /** source is drawn blue, target green, whichever databases they are */
  role: 'source' | 'target' | 'third';
  /** database id, for the version filter */
  db: string;
  dbName: string;
  /** the database's definition, for role tags and why the lab skips a command */
  database?: Database;
  support: DatabaseEntry['support'];
  commands: Command[];
  entryId: string;
  verification: Verification | null;
}
const { lang, role, db, dbName, database, support, commands, entryId, verification } = Astro.props;
const ui = UI[lang];
const p = ui.proof;

function versionLabel(c: Command): string {
  if (c.since && c.removed_in) return `${c.since} – ${c.removed_in}`;
  if (c.since) return ui.since(c.since);
  if (c.removed_in) return ui.until(c.removed_in);
  return '';
}
---
<div class="card panel">
  <div class="panel-head">
    <span class={`dot dot-${role}`}></span>
    <span class={`side side-${role}`}>{dbName}</span>
    <span class="panel-support">{p.support[support]}</span>
  </div>
  {
    commands.map((c) => {
      const skip = labSkip(c, database);
      const runs = skip ? [] : commandRuns(verification, entryId, db, c).filter((r) => r.outcome === 'ok' || r.outcome === 'fails-as-expected');
      const names = roleNames(c, database);
      const range = versionLabel(c);
      return (
        <div class="cmd" data-ver data-ver-db={db} data-since={c.since} data-removed={c.removed_in}>
          <div class="cmd-line">
            <code>{c.cmd}</code>
            <button type="button" class="copy" data-copy={c.cmd}>
              {ui.copy}
            </button>
          </div>
          <div class="cmd-meta">
            <span class="ver-note badge badge-approx" hidden />
            {names.length > 0 && (
              <span class="roles" title={ui.runsOn}>
                {names.map((n) => (
                  <span class="tag tag-role">{n}</span>
                ))}
              </span>
            )}
            {range && <span class="tag">{range}</span>}
            {c.deprecated_in && <span class="badge badge-approx">{ui.deprecatedIn(c.deprecated_in)}</span>}
          </div>
          {(skip || runs.length > 0) && (
            <div class="runs" aria-label={p.runsLabel}>
              {skip ? (
                <span class="run run-skip">{ui.notRunByLab(t(skip, lang))}</span>
              ) : (
                runs.map((r) => (
                  <span class:list={['run', r.outcome === 'ok' ? 'run-ok' : 'run-fail']} data-verified data-db={db} data-v={r.line}>
                    {r.outcome === 'ok' ? p.runOk(r.server) : p.runFails(r.server)}
                  </span>
                ))
              )}
            </div>
          )}
          {c.note && <p class="cmd-note">{t(c.note, lang)}</p>}
        </div>
      );
    })
  }
</div>
