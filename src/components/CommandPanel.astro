---
import { t, UI, type Lang } from '../lib/i18n';
import type { Command } from '../lib/schema';

interface Props {
  lang: Lang;
  /** source is drawn blue, target green, whichever databases they are */
  role: 'source' | 'target';
  dbName: string;
  commands: Command[];
}
const { lang, role, dbName, commands } = Astro.props;
const ui = UI[lang];

function versionLabel(c: Command): string {
  if (c.since && c.until) return `${c.since} – ${c.until}`;
  if (c.since) return ui.since(c.since);
  if (c.until) return ui.until(c.until);
  return ui.allVersions;
}
---
<div class="card panel">
  <div class="panel-head">
    <span class={`dot dot-${role}`}></span>
    <span class={`side side-${role}`} style="font-size: 13px">{dbName}</span>
  </div>
  {
    commands.map((c) => (
      <div class="cmd">
        <div class="cmd-line">
          <code>{c.cmd}</code>
          <button type="button" class="copy" data-copy={c.cmd}>
            {ui.copy}
          </button>
        </div>
        <div class="cmd-meta">
          <span class="tag">{versionLabel(c)}</span>
          {c.note && <span>{t(c.note, lang)}</span>}
        </div>
      </div>
    ))
  }
</div>
