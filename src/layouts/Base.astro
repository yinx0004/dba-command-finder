---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import { loadDataset } from '../lib/data';
import { labStatus } from '../lib/home';
import { UI, type Lang } from '../lib/i18n';
import { ciRunUrl, GITHUB, href, langHome, newIssueUrl } from '../lib/site';
import { loadVerification } from '../lib/verification';
import VersionBar from '../components/VersionBar.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** home shows the site nav; other pages show a search shortcut */
  variant?: 'home' | 'page';
  /** home footer line */
  footerNote?: string;
  /** the "我的版本" bar; the home page has version buttons of its own */
  versionBar?: boolean;
}

const { lang, title, description, variant = 'page', footerNote, versionBar = true } = Astro.props;
const ui = UI[lang];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Only a clean lab run earns the badge; CI deploys only after every lab job passed.
const lab = labStatus(loadDataset(), loadVerification());
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class:list={{ 'page-home': variant === 'home' }}>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={langHome(lang)}>
          <span class="logo-mark" aria-hidden="true">&gt;_</span>
          <span class="logo-name">{ui.siteName}</span>
        </a>
        {
          lab?.allAsExpected && (
            <a class="lab-pill" href={ciRunUrl()} title={ui.labPassedTitle}>
              <span class="lab-dot" aria-hidden="true"></span>
              {ui.labPassed(lab.date)}
            </a>
          )
        }
        {
          variant === 'home' ? (
            <nav class="site-nav" aria-label="站点">
              {/* Leave any ?q= behind: while searching, these sections are hidden and the anchors go nowhere. */}
              <a href={`${langHome(lang)}#browse`}>{ui.homePage.navIndex}</a>
              <a href={`${langHome(lang)}#method`}>{ui.homePage.navMethod}</a>
              <a href={GITHUB}>GitHub</a>
            </nav>
          ) : (
            <a class="search-pill" href={langHome(lang)}>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5" />
              </svg>
              {ui.searchLabel}
            </a>
          )
        }
      </div>
    </header>
    {versionBar && <VersionBar lang={lang} />}

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>{footerNote ?? ui.footerNote}</span>
        <span>{ui.license}</span>
        <a href={GITHUB}>GitHub</a>
        <a href={newIssueUrl()}>{ui.submitMapping}</a>
      </div>
    </footer>

    <script is:inline define:vars={{ copied: ui.copied }}>
      document.addEventListener('click', async (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-copy]') : null;
        if (!btn) return;
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-copy') || '');
        } catch {
          return;
        }
        const label = btn.textContent;
        btn.textContent = copied;
        setTimeout(() => (btn.textContent = label), 1500);
      });
    </script>
  </body>
</html>
