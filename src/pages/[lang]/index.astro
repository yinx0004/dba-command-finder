---
import Base from '../../layouts/Base.astro';
import GroupedCoverage from '../../components/GroupedCoverage.astro';
import Translator from '../../components/Translator.tsx';
import { categoryCoverage, coverageRow } from '../../lib/coverage';
import { loadDataset } from '../../lib/data';
import { pairMappings, siteDbs, toSearchDocs } from '../../lib/docs';
import { homeStats, labStatus } from '../../lib/home';
import { LANGS, UI, type Lang } from '../../lib/i18n';
import { runTotals, totalsByDb } from '../../lib/proof';
import { ciRunUrl, GITHUB, href } from '../../lib/site';
import { translateEntries } from '../../lib/translate';
import { loadVerification } from '../../lib/verification';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const h = ui.homePage;
const ds = loadDataset();
const v = loadVerification();
const sides = siteDbs(ds);
const pairDbs = sides.map((s) => s.def);
const stats = homeStats(ds);
const lab = labStatus(ds, v);
const mappings = pairMappings(ds);

// The translator's data, built here so the browser does no lab arithmetic of its own.
const docs = toSearchDocs(ds, lang);
const entries = translateEntries(ds, v, lang, pairDbs.map((d) => d.id));
const dbs = sides.map((s) => ({ id: s.def.id, name: s.def.name, vers: s.def.lab_versions, role: s.role }));

// --- Coverage: every task, grouped by category, deprecated ones last within each ---
const coverage = categoryCoverage(ds, pairDbs, lang);
const groups = coverage.rows.map((c) => ({
  id: c.id,
  name: c.name,
  rows: mappings
    .filter((m) => m.category === c.id)
    .sort((a, b) => Number(a.status === 'deprecated') - Number(b.status === 'deprecated'))
    .map((m) => coverageRow(m, pairDbs, lang)),
}));

const ledger = totalsByDb(runTotals(ds, v));
const ledgerSum = { versions: ledger.reduce((n, g) => n + g.runs.length, 0), commands: ledger.reduce((n, g) => n + g.commands, 0), fields: ledger.reduce((n, g) => n + g.fields, 0), mismatches: ledger.reduce((n, g) => n + g.mismatches, 0) };
---
<Base lang={lang} title={`${ui.siteName}：${ui.taglineAll(pairDbs.map((d) => d.name))}`} description={ui.heroSubAll(pairDbs.map((d) => d.name))} variant="home" versionBar={false} footerNote={h.footer(stats.versions)}>
  <main class="wrap home">
    <section class="home-top">
      <h1>{h.title}</h1>
      <p class="home-lede">{h.lede}</p>
      <p class="home-facts">
        <span><b>{stats.entries}</b> {h.facts.entries}</span>
        <span><b>{stats.labCommands}</b> {h.facts.labCommands}</span>
        <span><b>{stats.versions}</b> {h.facts.versions}</span>
        <span>{h.facts.rerun}</span>
      </p>
    </section>

    <Translator
      client:load
      docs={docs}
      entries={entries}
      dbs={dbs}
      tries={ds.site.home_tries}
      entryBase={href(`${lang}/`)}
      issueBase={`${GITHUB}/issues/new?title=`}
      L={ui.tr}
    />

    <section class="home-section" id="browse">
      <div class="home-section-head">
        <h2>{h.matrixTitle}</h2>
        <span class="cov-legend">
          {h.matrixLegend}
          <span><i class="seg-full" aria-hidden="true"></i>{h.support.full}</span>
          <span><i class="seg-partial" aria-hidden="true"></i>{h.support.partial}</span>
          <span><i class="seg-none" aria-hidden="true"></i>{h.support.none}</span>
          <span class="cov-hint">ⓘ {h.matrixHint}</span>
        </span>
      </div>
      <p class="section-foot">{h.coverageNote(stats.entries)}</p>
      <GroupedCoverage lang={lang} dbs={pairDbs} groups={groups} totals={coverage.totals.map((x) => x.tally)} />
    </section>

    <section class="home-section home-method" id="method">
      <div class="home-method-text">
        <h2>{h.methodTitle}</h2>
        {h.method.map((p) => <p>{p}</p>)}
        <p class="home-links">
          <a href={ciRunUrl()}>{h.methodLinks.ci}</a>
          <a href={`${GITHUB}/tree/main/lab`}>{h.methodLinks.script}</a>
          <a href={`${GITHUB}/tree/main/data`}>{h.methodLinks.data}</a>
        </p>
      </div>
      {
        ledger.length > 0 && (
          <div class="home-ledger">
            <div class="home-ledger-head">
              <h3>{h.ledgerTitle}</h3>
              {lab && <span>{h.ledgerDate(lab.date)}</span>}
            </div>
            <div class="ledger" role="table">
              <div class="ledger-row ledger-th" role="row">
                <span role="columnheader">{h.ledger.db}</span>
                <span role="columnheader">{h.ledger.server}</span>
                <span role="columnheader" class="num">{h.ledger.commands}</span>
                <span role="columnheader" class="num">{h.ledger.fields}</span>
                <span role="columnheader">{h.ledger.result}</span>
              </div>
              {ledger.map((g) => (
                <details class="ledger-db">
                  <summary class="ledger-row" role="row">
                    <span role="cell" class="ledger-name">{g.name}</span>
                    <span role="cell" class="mono ledger-servers">{g.runs.map((r) => <span>{r.server}</span>)}</span>
                    <span role="cell" class="mono num">{g.commands}</span>
                    <span role="cell" class="mono num">{g.fields}</span>
                    <span role="cell" class={g.mismatches ? 'ledger-bad' : 'ledger-ok'}>{g.mismatches ? h.ledger.badShort(g.mismatches) : '✓'}</span>
                  </summary>
                  {g.runs.map((r) => (
                    <div class="ledger-row ledger-run" role="row">
                      <span role="cell">{r.name} {r.line}</span>
                      <span role="cell" class="mono">{r.server}</span>
                      <span role="cell" class="mono num">{r.commands}</span>
                      <span role="cell" class="mono num">{r.fields}</span>
                      <span role="cell" class={r.mismatches ? 'ledger-bad' : 'ledger-ok'}>{r.mismatches ? h.ledger.badShort(r.mismatches) : '✓'}</span>
                    </div>
                  ))}
                </details>
              ))}
              <div class="ledger-row ledger-sum" role="row">
                <span role="cell" class="ledger-sum-label">
                  {h.ledger.total(ledgerSum.versions)}
                  <span class={ledgerSum.mismatches ? 'ledger-bad' : 'ledger-ok'}>{ledgerSum.mismatches ? h.ledger.bad(ledgerSum.mismatches) : h.ledger.ok}</span>
                </span>
                <span role="cell" class="mono num">{ledgerSum.commands}</span>
                <span role="cell" class="mono num">{ledgerSum.fields}</span>
                <span role="cell" class={ledgerSum.mismatches ? 'ledger-bad' : 'ledger-ok'}>{ledgerSum.mismatches ? h.ledger.badShort(ledgerSum.mismatches) : '✓'}</span>
              </div>
            </div>
            <p class="section-foot">{h.ledgerNote}</p>
          </div>
        )
      }
    </section>
  </main>
</Base>

