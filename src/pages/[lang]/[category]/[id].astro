---
import Base from '../../../layouts/Base.astro';
import EqBadge from '../../../components/EqBadge.astro';
import CommandPanel from '../../../components/CommandPanel.astro';
import { loadDataset } from '../../../lib/data';
import { pairMappings } from '../../../lib/docs';
import { LANGS, t, UI, type Lang } from '../../../lib/i18n';
import { equivalence, fieldRows } from '../../../lib/pair';
import { labSkip } from '../../../lib/roles';
import { categoryHref, editUrl, entryHref, langHome, lastUpdated, newIssueUrl } from '../../../lib/site';
import { entryVerification } from '../../../lib/verification';

export function getStaticPaths() {
  const ds = loadDataset();
  return LANGS.flatMap((lang) => pairMappings(ds).map((m) => ({ params: { lang, category: m.category, id: m.id } })));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const ds = loadDataset();
const { source, target } = ds.site.pair;
const dbName = new Map(ds.databases.map((d) => [d.id, d.name]));
const S = dbName.get(source)!;
const T = dbName.get(target)!;
const srcDb = ds.databases.find((d) => d.id === source);
const tgtDb = ds.databases.find((d) => d.id === target);
const m = ds.mappings.find((x) => x.category === Astro.params.category && x.id === Astro.params.id)!;
const byId = new Map(ds.mappings.map((x) => [x.id, x]));
const cat = ds.categories.find((c) => c.id === m.category)!;
const title = t(m.title, lang);
const updated = lastUpdated(m.file);
const replacement = m.replaced_by ? byId.get(m.replaced_by) : undefined;

const src = m.databases[source];
const tgt = m.databases[target];
const eq = equivalence(src, tgt);
const fields = fieldRows(m, source, target);
const notes = [
  ...(eq === 'none' ? [] : (tgt?.notes ?? []).map((n) => ({ db: T, text: n }))),
  ...src.notes.map((n) => ({ db: S, text: n })),
];
const alternatives = tgt?.alternatives ?? [];
const refs = [...src.refs, ...(tgt?.refs ?? [])];

// Lab results: "MySQL 5.7 · 8.0 ／ MongoDB 6.0 · 7.0", or unverified when the lab has not run.
const srcV = entryVerification(m.id, source);
const tgtV = entryVerification(m.id, target);
const verifiedParts = [
  [S, srcV],
  [T, tgtV],
]
  .filter(([, v]) => v && (v as NonNullable<typeof srcV>).versions.length)
  .map(([name, v]) => `${name} ${(v as NonNullable<typeof srcV>).versions.join(' · ')}`);
// Versions whose real output contained this field name ('' when none); shown as a ✓ in the field table.
const fieldFound = (v: typeof srcV, id: string) => (v?.fields?.[id]?.verified ?? []).join(' · ');
const anySkipped = ([[src, srcDb], [tgt, tgtDb]] as const).some(([d, def]) => d?.commands.some((c) => labSkip(c, def)));
const verifiedLabel = verifiedParts.length ? ui.verifiedOn(verifiedParts.join(' ／ ')) : ui.unverified;

// Titles read better without statement terminators: "SHOW SLAVE STATUS", not "SHOW SLAVE STATUS\G".
const bare = (cmd: string) => cmd.replace(/\s*(\\G|;)\s*$/, '');
const srcCmd = bare(src.commands[0]?.cmd ?? '');
const seoTitle =
  eq === 'none'
    ? `${title}：${srcCmd} 在 ${T} 中没有对应命令 | ${ui.siteName}`
    : eq === 'missing'
      ? `${title}：${srcCmd} | ${ui.siteName}`
      : `${title}：${srcCmd} 在 ${T} 中的对应命令 ${tgt!.commands[0].cmd} | ${ui.siteName}`;

const noteIcon = `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--approx-fg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg>`;
---
<Base lang={lang} title={seoTitle} description={t(m.summary, lang)}>
  <main class="wrap intent">
    <nav class="crumbs" aria-label="面包屑">
      <a href={langHome(lang)}>{ui.home}</a><span>/</span>
      <a href={categoryHref(lang, cat.id)}>{t(cat.name, lang)}</a><span>/</span>
      <span>{title}</span>
    </nav>

    {
      m.status === 'deprecated' && (
        <div class="banner" role="note">
          {ui.deprecated}
          {replacement && (
            <>
              ，{ui.replacedBy} <a href={entryHref(lang, replacement.slug)}>{t(replacement.title, lang)}</a>
            </>
          )}
        </div>
      )
    }

    <section class="intent-head">
      <h1>{title}</h1>
      <p class="lede">{t(m.summary, lang)}</p>
      <div class="meta">
        <EqBadge lang={lang} eq={eq} large />
        <span class:list={{ 'verified-label': verifiedParts.length > 0 }}>{verifiedLabel}</span>
        {anySkipped && <span>（{ui.someSkipped}）</span>}
        {updated && <span>· 更新于 {updated}</span>}
      </div>
    </section>

    <section class="panels">
      <CommandPanel lang={lang} role="source" db={source} dbName={S} database={srcDb} commands={src.commands} verification={srcV} />
      {
        eq === 'none' ? (
          <div class="card panel panel-none">
            <div class="panel-head">
              <span class="dot dot-target" />
              <span class="side side-target" style="font-size: 13px">{T}</span>
            </div>
            <div class="none-body">
              <div class="none-title">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M5.6 5.6l12.8 12.8" />
                </svg>
                {ui.noEquivalent}
              </div>
              {tgt!.notes.map((n) => <p>{t(n, lang)}</p>)}
            </div>
          </div>
        ) : eq === 'missing' ? (
          <div class="card panel panel-missing">
            <div class="panel-head">
              <span class="dot dot-target" />
              <span class="side side-target" style="font-size: 13px">{T}</span>
            </div>
            <div class="none-body">
              <p>{ui.notWritten}</p>
              <a href={editUrl(m.file)}>{ui.editOnGitHub}</a>
            </div>
          </div>
        ) : (
          <CommandPanel lang={lang} role="target" db={target} dbName={T} database={tgtDb} commands={tgt!.commands} verification={tgtV} />
        )
      }
    </section>

    {
      fields.length > 0 && (
        <section class="section">
          <h2>{ui.fields}</h2>
          <div class="card table-box">
            <table>
              <thead>
                <tr>
                  <th scope="col">{ui.fieldName}</th>
                  <th scope="col" style="color: var(--source)">{S}</th>
                  <th scope="col" style="color: var(--target)">{T}</th>
                  <th scope="col">{ui.fieldNote}</th>
                </tr>
              </thead>
              <tbody>
                {fields.map((f) => (
                  <tr>
                    <td>{f.name ? t(f.name, lang) : f.id}</td>
                    <td class="mono">
                      {f.source ?? '—'}
                      {fieldFound(srcV, f.id) && (
                        <span class="field-ok" title={ui.fieldFoundIn(fieldFound(srcV, f.id))} aria-label={ui.fieldFoundIn(fieldFound(srcV, f.id))}>
                          ✓
                        </span>
                      )}
                    </td>
                    <td class="mono">
                      {f.target ?? '—'}
                      {fieldFound(tgtV, f.id) && (
                        <span class="field-ok" title={ui.fieldFoundIn(fieldFound(tgtV, f.id))} aria-label={ui.fieldFoundIn(fieldFound(tgtV, f.id))}>
                          ✓
                        </span>
                      )}
                    </td>
                    <td style="color: var(--ink-2)">{t(f.note, lang)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="section">
          <h2>{ui.differences}</h2>
          <ul class="notes">
            {notes.map((n) => (
              <li class="card">
                <Fragment set:html={noteIcon} />
                <span>
                  {notes.some((x) => x.db !== T) && <span class="tag" style="margin-right: 8px">{n.db}</span>}
                  {t(n.text, lang)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      alternatives.length > 0 && (
        <section class="section">
          <h2 style="margin-bottom: 6px">{ui.alternatives(T)}</h2>
          <p class="muted" style="margin: 0 0 14px; font-size: 14px">{ui.alternativesSub}</p>
          <div class="alts">
            {alternatives.map((a) => {
              const see = a.see ? byId.get(a.see) : undefined;
              return (
                <div class="card alt">
                  <strong>{t(a.title, lang)}</strong>
                  {a.cmd && <code>{a.cmd}</code>}
                  {a.note && <span style="font-size: 14px; color: var(--ink-2); line-height: 1.6">{t(a.note, lang)}</span>}
                  {see && <a href={entryHref(lang, see.slug)} style="font-size: 14px">→ {t(see.title, lang)}</a>}
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {
      (m.related.length > 0 || refs.length > 0) && (
        <section class="section links-grid">
          {m.related.length > 0 && (
            <div>
              <h2>{ui.related}</h2>
              <div class="link-list">
                {m.related.map((id) => {
                  const r = byId.get(id)!;
                  return <a href={entryHref(lang, r.slug)}>{t(r.title, lang)}</a>;
                })}
              </div>
            </div>
          )}
          {refs.length > 0 && (
            <div>
              <h2>{ui.docs}</h2>
              <div class="link-list">
                {refs.map((r) => (
                  <a href={r.url} rel="noopener">{r.title}</a>
                ))}
              </div>
            </div>
          )}
        </section>
      )
    }

    <section class="page-foot">
      <a href={editUrl(m.file)}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z" />
        </svg>
        {ui.editOnGitHub}
      </a>
      <a href={newIssueUrl(`纠错：${m.slug}`)}>{ui.reportError}</a>
      <span class="muted mono" style="font-size: 13px">id: {m.slug}</span>
    </section>
  </main>
</Base>
