---
import Base from '../../../layouts/Base.astro';
import EqBadge from '../../../components/EqBadge.astro';
import { loadDataset } from '../../../lib/data';
import { LANGS, t, UI, type Lang } from '../../../lib/i18n';
import { categoryHref, entryHref, langHome, newIssueUrl } from '../../../lib/site';

export function getStaticPaths() {
  const ds = loadDataset();
  const used = new Set(ds.mappings.map((m) => m.category));
  return LANGS.flatMap((lang) =>
    ds.categories.filter((c) => used.has(c.id)).map((c) => ({ params: { lang, category: c.id } })),
  );
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const ds = loadDataset();
const used = new Set(ds.mappings.map((m) => m.category));
const categories = ds.categories.filter((c) => used.has(c.id));
const cat = categories.find((c) => c.id === Astro.params.category)!;
const entries = ds.mappings
  .filter((m) => m.category === cat.id)
  .sort((a, b) => Number(a.status === 'deprecated') - Number(b.status === 'deprecated'));
const name = t(cat.name, lang);
---
<Base lang={lang} title={`${name}：MySQL → MongoDB 命令对照 | ${ui.siteName}`} description={`${name}相关的 MySQL 运维命令在 MongoDB 中的对应写法：${t(cat.desc, lang)}`}>
  <div class="wrap cat-layout">
    <nav class="cat-nav" aria-label="类别">
      <span class="label">类别</span>
      {
        categories.map((c) => (
          <a href={categoryHref(lang, c.id)} aria-current={c.id === cat.id ? 'page' : undefined}>
            {t(c.name, lang)}
          </a>
        ))
      }
    </nav>

    <main class="cat-main">
      <nav class="crumbs" aria-label="面包屑">
        <a href={langHome(lang)}>{ui.home}</a><span>/</span><span>{name}</span>
      </nav>
      <h1 style="margin: 12px 0 8px">{name}</h1>
      <p class="lede" style="margin-bottom: 24px">{t(cat.desc, lang)}</p>

      <div class="card">
        {
          entries.map((m) => (
            <a class="row-link" href={entryHref(lang, m.slug)}>
              <div class="row-title">
                <strong>{t(m.title, lang)}</strong>
                <EqBadge lang={lang} eq={m.equivalence} />
                {m.status === 'deprecated' && <span class="tag">{ui.deprecated}</span>}
              </div>
              <div class="row-cmds">
                {m.mysql[0].cmd} → {m.mongodb[0]?.cmd ?? ui.noEquivalent}
              </div>
            </a>
          ))
        }
      </div>

      <p class="muted" style="margin-top: 20px; font-size: 14px">
        {ui.categoryEmpty}<a href={newIssueUrl()}>{ui.submitMapping}</a>
      </p>
    </main>
  </div>
</Base>
