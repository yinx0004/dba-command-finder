---
import Base from '../../../layouts/Base.astro';
import CoverageTable from '../../../components/CoverageTable.astro';
import { coverageRow } from '../../../lib/coverage';
import { loadDataset } from '../../../lib/data';
import { pairMappings } from '../../../lib/docs';
import { LANGS, t, UI, type Lang } from '../../../lib/i18n';
import { categoryHref, langHome, newIssueUrl } from '../../../lib/site';

export function getStaticPaths() {
  const ds = loadDataset();
  const used = new Set(pairMappings(ds).map((m) => m.category));
  return LANGS.flatMap((lang) =>
    ds.categories.filter((c) => used.has(c.id)).map((c) => ({ params: { lang, category: c.id } })),
  );
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const ds = loadDataset();
const { source, target } = ds.site.pair;
const pairDbs = [source, target].map((id) => ds.databases.find((d) => d.id === id)!);
const [S, T] = pairDbs.map((d) => d.name);
const mappings = pairMappings(ds);
const counts = new Map<string, number>();
for (const m of mappings) counts.set(m.category, (counts.get(m.category) ?? 0) + 1);
const categories = ds.categories.filter((c) => counts.get(c.id));
const cat = categories.find((c) => c.id === Astro.params.category)!;
const rows = mappings
  .filter((m) => m.category === cat.id)
  .sort((a, b) => Number(a.status === 'deprecated') - Number(b.status === 'deprecated'))
  .map((m) => coverageRow(m, pairDbs, lang));
const name = t(cat.name, lang);
---
<Base lang={lang} title={`${name}：${ui.tagline(S, T)} | ${ui.siteName}`} description={`${name}相关的 ${S} 运维命令在 ${T} 中的对应写法：${t(cat.desc, lang)}`}>
  <div class="wrap cat-layout">
    <nav class="cat-nav" aria-label={ui.homePage.navIndex}>
      <span class="label">{ui.homePage.navIndex}</span>
      {
        categories.map((c) => (
          <a href={categoryHref(lang, c.id)} aria-current={c.id === cat.id ? 'page' : undefined}>
            {t(c.name, lang)}
            <small>{counts.get(c.id)}</small>
          </a>
        ))
      }
    </nav>

    <main class="cat-main">
      <nav class="crumbs" aria-label="面包屑">
        <a href={langHome(lang)}>{ui.home}</a><span>/</span><span>{name}</span>
      </nav>
      <h1 class="cat-title">{name}</h1>
      <p class="lede">{t(cat.desc, lang)}</p>
      <p class="cat-legend">
        {ui.homePage.matrixLegend}
        <span><i class="seg-full" aria-hidden="true"></i>{ui.homePage.support.full}</span>
        <span><i class="seg-partial" aria-hidden="true"></i>{ui.homePage.support.partial}</span>
        <span><i class="seg-none" aria-hidden="true"></i>{ui.homePage.support.none}</span>
        <span>ⓘ {ui.homePage.matrixHint}</span>
      </p>

      <CoverageTable lang={lang} dbs={pairDbs} rows={rows} commands />

      <p class="section-foot" style="font-size: 14px">
        {ui.categoryEmpty}<a href={newIssueUrl()}>{ui.submitMapping}</a>
      </p>
    </main>
  </div>
</Base>
